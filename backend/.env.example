# Copy to backend/.env (bin/setup.sh does this for you).

# PostgreSQL connection (SQLAlchemy URL, psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://agricore:agricore@localhost:5432/agricore
TEST_DATABASE_URL=postgresql+psycopg://agricore:agricore@localhost:5432/agricore_test

# JWT signing secret - setup.sh generates a random one
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Browser origins allowed to call the API
CORS_ORIGINS=["http://localhost:5173"]

# S3 document storage.
# Locally we point boto3 at a moto S3 emulator (bin/start.sh runs it on :5001).
# On real AWS: delete S3_ENDPOINT_URL and the two fake keys and use an IAM role.
S3_BUCKET=agricore-service-reports
S3_ENDPOINT_URL=http://localhost:5001
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=testing
AWS_SECRET_ACCESS_KEY=testing
